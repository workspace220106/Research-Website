# ══════════════════════════════════════════
# GeoResearch Pipeline — API Keys (all free)
# ══════════════════════════════════════════
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Google Gemini (grounded search — 7 req/run, 20/day free limit)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxx

# OpenRouter (synthesis, audit, research paper, LaTeX — free models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx

# Tavily (web searches — free 1K/month)
# Get from: https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# NVIDIA NIM (YouTube script generation — free tier)
# Get from: https://build.nvidia.com (free Developer Program)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx

# Groq (fallback for scripts if no NVIDIA key — free tier)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# ══════════════════════════════════════════
# Optional: Obsidian vault path
# ══════════════════════════════════════════
# If set, research outputs are auto-copied to your Obsidian vault
# OBSIDIAN_VAULT=C:/path/to/vault
