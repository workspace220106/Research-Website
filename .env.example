# ══════════════════════════════════════════
# GeoResearch Pipeline — API Keys
# ══════════════════════════════════════════
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Google Gemini (claim extraction, fact-checking, synthesis, LaTeX, grounded search)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxx

# Tavily (Twitter search, news search, think tanks — free 1K/month)
# Get from: https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# Groq (YouTube script generation — free tier)
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# OpenAI (optional — used for scripts instead of Groq if set)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ══════════════════════════════════════════
# Optional: Obsidian vault path
# ══════════════════════════════════════════
# If set, research outputs are auto-copied to your Obsidian vault
# OBSIDIAN_VAULT=C:/path/to/vault
