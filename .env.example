# ══════════════════════════════════════════
# GeoResearch Pipeline — API Keys
# ══════════════════════════════════════════
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Claude (claim extraction, fact-checking, synthesis, LaTeX)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Perplexity (Twitter search, news search, think tanks)
# Get from: https://perplexity.ai/settings/api (min $5 credit)
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx

# Google Gemini (government sites, UN, NATO, BRICS via Google Search grounding)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxx

# OpenAI GPT-4o (YouTube script generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ══════════════════════════════════════════
# Optional: Obsidian vault path
# ══════════════════════════════════════════
# If set, research outputs are auto-copied to your Obsidian vault
# OBSIDIAN_VAULT=/Users/rakshan/Documents/ObsidianVault/GeoResearch
